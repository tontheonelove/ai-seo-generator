# ============================================================
# SEO EZ — ตัวอย่างตัวแปรสภาพแวดล้อม
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของคุณ
# ============================================================

# 🔑 คีย์ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 🤖 โมเดลฟรีเริ่มต้น (ดูรายชื่อได้ที่ https://openrouter.ai/models?max_price=0)
OPENROUTER_MODEL=deepseek/deepseek-v3.1:free