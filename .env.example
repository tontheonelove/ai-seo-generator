# ============================================================
# SEO EZ — ตัวอย่างตัวแปรสภาพแวดล้อม
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของคุณ
# ============================================================

# 🔑 คีย์ OpenRouter (https://openrouter.ai/keys)
# ⚠️ ห้ามเติม NEXT_PUBLIC_ — ต้องเป็นความลับฝั่ง server เท่านั้น
OPENROUTER_API_KEY=

# 📋 รายชื่อโมเดลทั้งหมดที่จะแสดงใน Dropdown
# Format: id1|label1,id2|label2,id3|label3
# 📌 เติม NEXT_PUBLIC_ เพื่อให้ฝั่ง client อ่านได้ (สำหรับ Dropdown)
#
# โมเดลแนะนำ (ฟรี & active ปี 2026):
# - inclusionai/ling-3.0-flash-fin:free → เร็ว, ตอบ JSON ดี, แนะนำที่สุด
# - liquid/lfm-2.5-2.6b:free → เล็ก เร็ว เหมาะทดสอบ
# - poolside/laguna-s-2.1:free → งานเขียนโค้ด/วิเคราะห์
# - minimax/minimax-m3:free → งานภาษาไทย/อังกฤษหลากหลาย
# - google/gemma-4-31b-it:free → เร็ว ประหยัด
#
# ดูรายชื่อโมเดลฟรีปัจจุบัน: https://openrouter.ai/models?max_price=0
NEXT_PUBLIC_OPENROUTER_MODELS="inclusionai/ling-3.0-flash-fin:free|Ling 3.0 Flash (แนะนำ),liquid/lfm-2.5-2.6b:free|Liquid 2.5,poolside/laguna-s-2.1:free|Laguna S 2.1,minimax/minimax-m3:free|MiniMax M3,google/gemma-4-31b-it:free|Gemma 4 31B"

# 🤖 โมเดลเริ่มต้น (ต้องมีอยู่ในรายการข้างบน)
# 📌 เติม NEXT_PUBLIC_ เช่นกัน เพื่อให้ server/client เห็นค่าเดียวกัน
NEXT_PUBLIC_OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free